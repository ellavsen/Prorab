# TEMPLATE ONLY — this file IS committed and published.
# Keep every value on the right-hand side EMPTY.
# Real secrets go into .env, which is git-ignored:  cp .env.example .env

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# SQLAlchemy database URL
ESTIMATE_DB_URL=sqlite:///estimate.db

# OpenAI API key: Whisper for voice, gpt-4.1-mini for extraction and photos.
# Optional. Without it the AI layer falls back to a stub and the bot still runs.
OPENAI_API_KEY=

# Public base URL of apps/share, e.g. https://smeta.example.com
# The customer's link is built as {SHARE_BASE_URL}/e/{token}. Not a secret —
# the token is, and it never lives in the environment. Defaults to localhost.
SHARE_BASE_URL=

# Refuse to substitute a price when the unit is not canonical (ADR-015).
# On by default; set to 0 to disable without touching code.
UNIT_BLOCKING_ENABLED=


# ─────────────────────────────────────────────────────────────────────────────
# Что меняется в проде. Полностью — docs/deploy.md.
#
#   ESTIMATE_DB_URL   На постоянный том, а не в рабочий каталог. Относительный
#                     путь означает «рядом с процессом», а у процесса в
#                     контейнере рабочий каталог живёт ровно до обновления:
#                       Docker    sqlite:////data/estimate.db      (четыре /)
#                       systemd   sqlite:////var/lib/prorab/estimate.db
#                     Четвёртый слэш — не опечатка: это признак абсолютного
#                     пути в URL SQLAlchemy, и с тремя база молча создастся не
#                     там, где вы её потом ищете.
#
#   SHARE_BASE_URL    Реальный домен по https. Значение по умолчанию —
#                     localhost, и на сервере оно даст заказчику ссылку,
#                     которая открывается только на самом сервере. Ошибка
#                     тихая: /send отработает, ссылка уедет, откроется у
#                     никого.
#
# Файл в прод не копируется вместе с образом: секреты приходят в окружение на
# запуске (.dockerignore исключает .env). На сервере — chmod 600 и владелец
# того пользователя, от которого работает сервис.
# ─────────────────────────────────────────────────────────────────────────────
