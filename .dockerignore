# Виртуальное окружение переносить между машинами бессмысленно — в нём
# абсолютные пути (README, «Не держите проект в синхронизируемой папке»).
# В образе оно тем более лишнее: своё собирается на стадии build.
.venv/
venv/

# Секреты в образ не едут. Ключи приходят через окружение на запуске.
.env

# База — на томе, а не в образе. Локальная содержит реальные сметы.
*.db
*.sqlite3
*.xlsx

.git/
.github/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Тесты в рантайме не нужны; CI гоняет их из исходников, а не из образа.
tests/
.pytest_cache/
.hypothesis/
.coverage
htmlcov/
.ruff_cache/

# Демо публикуется на Pages отдельным workflow и в контейнер не входит
# (docs/deploy.md, §«Чего здесь нет»).
apps/web/
node_modules/

python3/
docs/
.DS_Store
