# Обратный прокси перед apps/share. Скопировать, заменить smeta.example.com на
# свой домен, положить в /etc/nginx/sites-available/prorab и включить симлинком.
#
# Этот файл закрывает ровно ту дыру, которую ADR-020 §6 называет и честно
# оставляет открытой: «настройка прокси — часть развёртывания, и её нельзя
# закрыть кодом». Приложение режет токен в своём журнале, но nginx пишет свой,
# и по умолчанию — полный путь. Каждая строка обычного access.log была бы
# рабочей ссылкой на чужую смету.

# Путь без токена. Первое правило — ссылка целиком, второе — действие над ней
# (/e/{token}/approve): «что сделали» из журнала пропадать не должно, пропасть
# должно только «над чем именно».
map $uri $uri_no_token {
    default                     $uri;
    "~^/e/[^/]+$"               "/e/***";
    "~^/e/[^/]+(?<tail>/.+)$"   "/e/***$tail";
}

# $request сюда не входит намеренно: он содержит полный путь, ради которого всё
# и затевалось. Адреса и User-Agent тоже нет — ADR-020 §8 говорит, что про
# открывшего смету не хранится ничего, кроме двух отметок времени, и было бы
# странно соблюдать это в базе и нарушать в логе на той же машине.
log_format prorab_no_token '$time_local "$request_method $uri_no_token $server_protocol" '
                           '$status $body_bytes_sent';

server {
    listen 80;
    listen [::]:80;
    server_name smeta.example.com;

    # Единственное, что живёт по http, — продление сертификата.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name smeta.example.com;

    # certbot certonly --webroot -w /var/www/certbot -d smeta.example.com
    ssl_certificate     /etc/letsencrypt/live/smeta.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/smeta.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    access_log /var/log/nginx/prorab.access.log prorab_no_token;

    # На уровне info и debug nginx пишет запрос целиком, включая токен.
    # warn — граница, за которой этого уже не происходит.
    error_log  /var/log/nginx/prorab.error.log warn;

    # Версия nginx в заголовке ответа — бесплатная подсказка тому, кто ищет
    # непропатченный сервер.
    server_tokens off;

    # Смета — это десятки килобайт текста, файлов страница не принимает.
    client_max_body_size 64k;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-Proto $scheme;

        # X-Forwarded-For здесь нет намеренно. Приложение адрес не пишет и
        # писать не должно; заголовок означал бы, что адрес всё-таки едет
        # внутрь — и однажды окажется в чьём-нибудь логе.

        # Заголовки безопасности выставляет само приложение (CSP, no-referrer,
        # noindex, no-store — apps/share/main.py). Дублировать их здесь значило
        # бы завести второй источник истины про одно и то же.
        proxy_read_timeout 30s;
    }
}

# API (apps/api) — если он нужен снаружи, например для LIVE-режима демо.
# Состояния и секретов у него нет, CORS открыт всем намеренно (ADR-008),
# поэтому и прятать нечего: здесь достаточно обычного лога.
#
